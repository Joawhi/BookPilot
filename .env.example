# Copy to .env and fill in. Never commit real secrets.

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production
DATABASE_URL="file:../data/bookpilot.db"

# Uploads (PDFs stay private per user, never shared)
UPLOAD_DIR=./data/uploads

# LLM — all model calls happen on the server.
# Leave empty to use the built-in extractive fallback (the app still works).
# Preferred: OpenAI-compatible API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional contact email sent as User-Agent to OpenAlex (polite academic API use)
CONTACT_EMAIL=bookpilot@localhost
