# Copy to .env and fill in. Never commit real secrets.

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production
DATABASE_URL="file:../data/bookpilot.db"

# Uploads (PDFs stay private per user, never shared)
UPLOAD_DIR=./data/uploads

# LLM — all model calls happen on the server.
# Free path: Groq (no credit card). Create a key at https://console.groq.com/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b

# Paid / prepaid alternative: Gemini in Google AI Studio
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-flash-latest

# Optional contact email sent as User-Agent to OpenAlex (polite academic API use)
CONTACT_EMAIL=bookpilot@localhost
